<?xml version="1.0" encoding="utf-8"?>
<!--
Backup rules for Android 12+ (API 31+). The Rupee database and alert
SharedPreferences contain raw notification bodies, parsed amounts/merchants,
and masked card digits — exclude them from both cloud backup and device-to-
device transfer. The app install itself can migrate; the data cannot.

For API < 31, see `full_backup_content.xml`.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="rupee.db" />
        <exclude domain="database" path="rupee.db-journal" />
        <exclude domain="database" path="rupee.db-shm" />
        <exclude domain="database" path="rupee.db-wal" />
        <exclude domain="sharedpref" path="rupee_onboarding.xml" />
        <exclude domain="sharedpref" path="rupee_budget_alert_prefs.xml" />
        <exclude domain="sharedpref" path="rupee_dues_alert_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="rupee.db" />
        <exclude domain="database" path="rupee.db-journal" />
        <exclude domain="database" path="rupee.db-shm" />
        <exclude domain="database" path="rupee.db-wal" />
        <exclude domain="sharedpref" path="rupee_onboarding.xml" />
        <exclude domain="sharedpref" path="rupee_budget_alert_prefs.xml" />
        <exclude domain="sharedpref" path="rupee_dues_alert_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
